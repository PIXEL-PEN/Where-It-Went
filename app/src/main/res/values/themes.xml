<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.ExpenseTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary branding color -->
        <item name="colorPrimary">#607D8B</item> <!-- Blue-gray -->
        <item name="colorPrimaryVariant">#546E7A</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary color (optional) -->
        <item name="colorSecondary">#B0BEC5</item>
        <item name="colorSecondaryVariant">#90A4AE</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Remove default Material button tint -->
        <item name="materialButtonStyle">@style/BlueGrayButton</item>
    </style>

    <!-- Custom button style -->
    <style name="BlueGrayButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- v3.4: Settings sections, all alike -->
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@color/settings_header_bg</item>
        <item name="android:textColor">@color/settings_header_text</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_settings_card</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/colorAccent2</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
