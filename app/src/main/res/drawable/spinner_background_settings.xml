<?xml version="1.0" encoding="utf-8"?>
<!-- v3.4: a light outlined field with a dropdown arrow (was a salmon gradient) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_field_bg" />
            <stroke android:width="1dp" android:color="@color/settings_header_text" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_dropdown_settings"
        android:gravity="end|center_vertical"
        android:right="8dp" />
</layer-list>
