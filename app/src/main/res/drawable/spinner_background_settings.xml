<?xml version="1.0" encoding="utf-8"?>
<!-- v3.4: amber field with a dropdown arrow, same in light and dark mode -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/header_bg_amber" />
            <stroke android:width="1dp" android:color="#C9A24E" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_dropdown_settings"
        android:gravity="end|center_vertical"
        android:right="6dp" />
</layer-list>
