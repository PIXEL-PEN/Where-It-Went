<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/colorPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <!-- BACK + TITLE -->
        <LinearLayout
            android:id="@+id/title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:src="@drawable/ic_arrow_back_white"
                android:tint="@android:color/white"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Accounts"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- OVERFLOW MENU -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="2dp"
            android:background="@null"
            android:src="@drawable/baseline_more_horiz_35"
            android:tint="@android:color/white"
            android:scaleType="centerInside"
            android:contentDescription="Menu" />

        <!-- FILTER INDICATOR -->
        <TextView
            android:id="@+id/text_filter_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btn_menu"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="18dp"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:alpha="0.92"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- CONTENT (v3.4: framed, so the Accounts-only + button can float over it) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/accounts_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/accounts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </ScrollView>

        <!-- v3.4: shown only when Accounts is the home screen -->
        <ImageButton
            android:id="@+id/fab_add_account"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="17dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/fab_button_flat"
            android:contentDescription="Add an entry"
            android:elevation="6dp"
            android:src="@drawable/ic_add_plus"
            android:tint="@android:color/white"
            android:visibility="gone" />

        <!-- v3.4: Travel mode is on: one tap back to the trip (as on the main screen) -->
        <TextView
            android:id="@+id/travel_pill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="17dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_travel_pill"
            android:elevation="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="180dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:text="✈  Trip"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
