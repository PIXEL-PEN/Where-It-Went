<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/top_bar_container"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@color/colorPrimary"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="13dp"
                android:text="Settings"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/tv_title"
                android:layout_marginBottom="-6dp"
                android:src="@drawable/ic_arrow_forward_white"
                android:background="@null"
                android:tint="@android:color/white"
                android:contentDescription="Back to Main" />
        </RelativeLayout>

        <TextView
            style="@style/SettingsHeader"
            android:text="Currency" />

        <LinearLayout style="@style/SettingsCard">

            <Spinner
                android:id="@+id/spinner_currency"
                android:layout_width="240dp"
                android:layout_height="40dp"
                android:background="@drawable/spinner_background_settings"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:text="Opening Screen" />

        <LinearLayout style="@style/SettingsCard">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_accounts_only"
                app:thumbTint="@color/switch_thumb_settings"
                app:trackTint="@color/switch_track_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Accounts only"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For tracking projects and trips without Daily Living. The app opens on Accounts, and + adds to an account. Your Daily Living entries are kept; turn this off to see them again."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:text="Database Management" />

        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_export"
                style="@style/SettingsButton"
                android:layout_marginEnd="10dp"
                android:text="Export" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_import"
                style="@style/SettingsButton"
                android:layout_marginEnd="10dp"
                android:text="Import" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reset"
                style="@style/SettingsButton"
                android:text="Reset" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeader"
            android:text="About" />

        <LinearLayout
            style="@style/SettingsCard"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/text_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:linksClickable="true"
                android:text=""
                android:textColorLink="@color/settings_header_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>